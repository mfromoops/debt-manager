{
  "name": "debt-manager-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "auth:dev": "pnpm --filter debt-manager-auth dev",
    "auth:deploy": "pnpm --filter debt-manager-auth deploy",
    "auth:test": "pnpm --filter debt-manager-auth test",
    "sync:dev": "pnpm --filter debt-manager-sync dev -- --port 8788",
    "sync:deploy": "pnpm --filter debt-manager-sync deploy",
    "sync:typecheck": "pnpm --filter debt-manager-sync exec tsc --noEmit",
    "mobile:build:apk": "cd apps/mobile && flutter build apk --release --dart-define=WORKOS_CLIENT_ID=client_01M07XGHQJENJASNY4P2CM2E11 --dart-define=AUTH_BACKEND_BASE_URL=https://debt-manager-auth.mariofloresdev.com --dart-define=SYNC_BACKEND_BASE_URL=https://debt-manager-sync.mariofloresdev.com --dart-define=WORKOS_REDIRECT_URI=com.mortgagetracker.tracker://auth/callback --dart-define=WORKOS_PROVIDER=GoogleOAuth"
  },
  "packageManager": "pnpm@11.7.0"
}
