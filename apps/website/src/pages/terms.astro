---
import Layout from "../layouts/Layout.astro";
import { ArrowUpRight } from "@lucide/astro";
---

<Layout title="DebtFold terms">
    <main class="mx-auto max-w-4xl px-5 pt-14 pb-30 md:px-8">
        <a class="mb-30 inline-flex items-center gap-2 font-display text-lg font-semibold tracking-tight" href="/"><ArrowUpRight size={18} /> DebtFold</a>
        <p class="mb-6 text-xs font-semibold tracking-widest text-brand uppercase">Terms of use</p>
        <h1 class="max-w-3xl font-display text-5xl leading-tight font-medium md:text-6xl">Use the forecast as a tool, not a promise.</h1>
        <p class="mt-7 mb-7.5 max-w-2xl text-lg text-muted">DebtFold provides educational illustrations and planning tools. Nothing on this site is financial, legal, or lending advice. Review your lender terms and consult a qualified professional for decisions about your finances.</p>
        <a class="mt-24 block text-sm text-brand" href="/">← Back home</a>
    </main>
</Layout>
