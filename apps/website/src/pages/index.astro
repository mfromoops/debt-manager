---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Debt Manager — See what changes before you choose a strategy">
    <header class="nav wrap">
        <a class="wordmark" href="/"
            ><img class="brand-logo" src="/logo-new.png" alt="" /><span
                >debt manager</span
            ></a
        ><nav class="nav-links">
            <a href="#how">How it works</a><a href="/engine">Engine</a><a
                href="/methodology">Methodology</a>
        </nav><a class="button small header-cta" href="#simulator">Try it ↗</a>
    </header>
    <main>
        <section>
            <div class="hero-copy">
                <p class="eyebrow">Debt payoff simulator</p><h1>
                    Know which debt move changes your timeline.
                </h1><p class="lede">
                    Compare avalanche, snowball, and extra-payment plans before
                    you commit. Debt Manager turns balances, rates, and budgets
                    into a month-by-month payoff forecast.
                </p><div class="actions">
                    <a class="button" href="#simulator">Run a demo forecast ↗</a
                    ><a class="secondary-button" href="#institutions"
                        >For banks and fintechs →</a>
                </div><p class="trust-cue">
                    Synthetic example · Visible assumptions · No account
                    required
                </p>
            </div><figure class="hero-art">
                <img src="/hero.png" alt="" aria-hidden="true" />
                <figcaption class="hero-panel">
                    <div class="hero-panel-head">
                        <span>Demo forecast</span><strong>3 debts</strong>
                    </div>
                    <div class="hero-metrics">
                        <div>
                            <small>Debt-free</small><strong>May 2031</strong>
                        </div>
                        <div>
                            <small>Interest saved</small><strong>$4,920</strong>
                        </div>
                        <div>
                            <small>Time saved</small><strong>18 months</strong>
                        </div>
                    </div>
                    <div class="hero-bars" aria-hidden="true">
                        <span style="--height: 82%"></span>
                        <span style="--height: 66%"></span>
                        <span style="--height: 48%"></span>
                        <span style="--height: 30%"></span>
                        <span style="--height: 14%"></span>
                    </div>
                    <p>Avalanche plan applies extra budget to the highest-rate balance first.</p>
                </figcaption>
            </figure>
        </section>
        <section class="section problem wrap">
            <p class="eyebrow">The tradeoff is the point</p><h2>
                Most debt decisions are made without seeing the tradeoff.
            </h2><div class="three">
                <div>
                    <span class="num">01</span><p>
                        Paying extra toward the wrong balance can cost time and
                        interest.
                    </p>
                </div><div>
                    <span class="num">02</span><p>
                        A spreadsheet shows numbers; it rarely shows the whole
                        path.
                    </p>
                </div><div>
                    <span class="num">03</span><p>
                        A strategy only works when you can understand it and
                        keep following it.
                    </p>
                </div>
            </div>
        </section>
        <section id="simulator" class="section sim">
            <div class="wrap">
                <div class="intro">
                    <p class="eyebrow">Try a scenario</p><h2>
                        Change one number. See what changes.
                    </h2><p>
                        Explore a synthetic example using the same explainable
                        logic that powers Debt Manager.
                    </p>
                </div><div class="sim-grid">
                    <div class="card controls">
                        <div class="control-head">
                            <span class="eyebrow">Your extra budget</span
                            ><output id="budget-output">$200 / month</output>
                        </div><input
                            id="budget"
                            type="range"
                            min="0"
                            max="800"
                            step="25"
                            value="200"
                            aria-label="Extra monthly budget"
                        /><div class="range">
                            <span>$0</span><span>$800</span>
                        </div><p class="eyebrow toggle-label">Strategy</p><div
                            class="toggle"
                            role="group"
                            aria-label="Payoff strategy"
                        >
                            <button class="active" data-strategy="avalanche"
                                >Avalanche</button
                            ><button data-strategy="snowball">Snowball</button>
                        </div><label class="field"
                            >One-time payment <small>(optional)</small><div
                                class="input"
                            >
                                $ <input
                                    id="lump"
                                    value="0"
                                    inputmode="numeric"
                                    aria-label="One-time payment"
                                />
                            </div></label
                        ><button class="reset" id="reset">Reset demo</button
                        ><div class="debt-inputs">
                            <p class="eyebrow">Synthetic debts</p><div>
                                Credit card <b>$8,400</b><small
                                    >24.99% APR · $250 minimum</small>
                            </div><div>
                                Auto loan <b>$18,000</b><small
                                    >7.25% APR · $420 minimum</small>
                            </div><div>
                                Student loan <b>$24,000</b><small
                                    >5.50% APR · $275 minimum</small>
                            </div>
                        </div>
                    </div><div class="card">
                        <div class="result-head">
                            <div>
                                <p class="eyebrow">Projected outcome</p><h3
                                    id="strategy-title"
                                >
                                    Avalanche plan
                                </h3>
                            </div><span class="pill">Synthetic data</span>
                        </div><div class="metrics">
                            <div>
                                <small>Debt-free</small><strong id="date"
                                    >May 2031</strong>
                            </div><div>
                                <small>Interest paid</small><strong
                                    id="interest">$13,580</strong>
                            </div><div>
                                <small>Months saved</small><strong
                                    class="green"
                                    id="months">18</strong>
                            </div>
                        </div><svg
                            class="sim-chart"
                            viewBox="0 0 640 220"
                            role="img"
                            aria-label="Projected balance declining over time"
                            ><path
                                class="grid"
                                d="M0 20H640M0 70H640M0 120H640M0 170H640"
                            ></path><path
                                class="line muted"
                                d="M0 19 C100 30 210 55 310 90 S500 145 640 180"
                            ></path><path
                                id="selected"
                                class="line accent"
                                d="M0 19 C80 38 135 72 190 112 S300 174 380 180 L640 180"
                            ></path></svg
                        ><div class="sim-legend">
                            <i class="dot-muted"></i> Minimum payments　 <i
                                class="dot-accent"></i> Selected plan
                        </div><div class="payoff">
                            Payoff order　 <b>01</b>
                            <span id="first">Credit card</span>
                            <b>02</b> Auto loan　 <b>03</b> Student loan
                        </div><p class="explain" id="explain">
                            This example applies $200/month above minimum
                            payments using Avalanche. The highest-rate balance
                            receives the extra amount first; when it is paid
                            off, its payment rolls to the next balance.
                        </p><p
                            class="screen-reader"
                            id="result-summary"
                            aria-live="polite"
                        >
                        </p>
                    </div>
                </div><p class="trust-cue">
                    Synthetic example · Visible assumptions · No account
                    required
                </p><p class="disclaimer">
                    Illustrative example. Results depend on the information
                    entered and are not financial advice.
                </p><a class="button" href="https://dm.mariofloresdev.com"
                    >Try with your own debts ↗</a>
            </div>
        </section>
        <section id="how" class="section wrap">
            <div class="intro">
                <p class="eyebrow">The explainable engine</p><h2>
                    A plan you can explain, not just a number you can admire.
                </h2>
            </div><div class="steps">
                <div>
                    <span>01</span><h3>Model</h3><p>
                        Enter balances, rates, payments, dates, and cadence.
                    </p>
                </div><div>
                    <span>02</span><h3>Simulate</h3><p>
                        Project debt month by month, including interest and
                        extra payments.
                    </p>
                </div><div>
                    <span>03</span><h3>Compare</h3><p>
                        See avalanche, snowball, minimum-only, and custom
                        outcomes.
                    </p>
                </div><div>
                    <span>04</span><h3>Act</h3><p>
                        Apply a strategy, track progress, and update the
                        forecast.
                    </p>
                </div>
            </div><a class="text-link" href="/engine">Explore the engine →</a>
        </section>
        <section class="section capability-section wrap">
            <p class="eyebrow">Engine capabilities</p><h2>
                Small inputs. A complete picture.
            </h2><div class="capabilities">
                <div>
                    <b>Multi-debt projections</b><p>
                        See all balances move together in one month-by-month
                        forecast.
                    </p>
                </div><div>
                    <b>Payment rollover</b><p>
                        When one balance closes, its payment moves to the next
                        target.
                    </p>
                </div><div>
                    <b>Interest and principal</b><p>
                        Separate the cost of borrowing from the progress you
                        make.
                    </p>
                </div><div>
                    <b>Never-pays-off warnings</b><p>
                        Surface insufficient payments instead of hiding an
                        impossible result.
                    </p>
                </div><div>
                    <b>Explainable assumptions</b><p>
                        Every result can be traced back to the inputs and
                        strategy.
                    </p>
                </div><div>
                    <b>Deterministic outputs</b><p>
                        The same scenario always produces the same forecast.
                    </p>
                </div>
            </div><div class="bank-callout">
                <p class="eyebrow">Why banks care</p><p>
                    The same explainable simulation layer can power a
                    debt-planning experience inside a bank, credit union,
                    fintech, or financial-wellness platform.
                </p>
            </div>
        </section>
        <section id="institutions" class="section institution">
            <div class="wrap institution-grid">
                <div>
                    <p class="eyebrow">For financial institutions</p><h2>
                        Give people a clearer way to move forward.
                    </h2>
                </div><div>
                    <p>
                        License the deterministic simulation engine for your
                        bank, credit union, fintech, or financial-wellness
                        product.
                    </p><a
                        class="button button-light"
                        href="mailto:hello@debtmanager.app"
                        >Talk about the engine ↗</a>
                </div>
            </div>
        </section>
        <section class="section wrap">
            <p class="eyebrow">Built for trust</p><div class="trust-grid">
                <h2>Clear assumptions.<br />No hidden advice.</h2><div>
                    <p>
                        Debt Manager models the information you provide. It does
                        not connect to your bank, recommend lending products, or
                        make promises about your financial future.
                    </p><a class="text-link" href="/methodology"
                        >Read our methodology →</a>
                </div>
            </div>
        </section>
    </main><footer class="footer">
        <div class="wrap">
            <a class="wordmark" href="/"
                ><img class="brand-logo" src="/logo-new.png" alt="" /><span
                    >debt manager</span
                ></a
            ><div>
                <a href="/methodology">Methodology</a><a href="/privacy"
                    >Privacy</a
                ><a href="/terms">Terms</a>
            </div><small
                >© 2026 Debt Manager. Illustrative information, not financial
                advice.</small>
        </div>
    </footer>
</Layout>
<script>
    import { DEMO_DEBTS, simulateDebts, type Strategy } from "../lib/debt-engine";
    const budget = document.querySelector("#budget") as HTMLInputElement,
        out = document.querySelector("#budget-output") as HTMLElement,
        lump = document.querySelector("#lump") as HTMLInputElement,
        interest = document.querySelector("#interest") as HTMLElement,
        months = document.querySelector("#months") as HTMLElement,
        date = document.querySelector("#date") as HTMLElement,
        title = document.querySelector("#strategy-title") as HTMLElement,
        explain = document.querySelector("#explain") as HTMLElement,
        first = document.querySelector("#first") as HTMLElement,
        summary = document.querySelector("#result-summary") as HTMLElement,
        reset = document.querySelector("#reset") as HTMLButtonElement;
    const strategyButtons =
        document.querySelectorAll<HTMLButtonElement>("[data-strategy]");
    let strategy: Strategy = "avalanche";
    function update() {
        const extra = Number(budget.value),
            one = Number((lump.value || "0").replace(/[^0-9]/g, "")),
            result = simulateDebts(DEMO_DEBTS, extra, strategy, one),
            label = strategy[0].toUpperCase() + strategy.slice(1);
        out.textContent = `$${extra.toLocaleString()} / month`;
        interest.textContent = result.neverPaysOff
            ? "Does not pay off"
            : `$${Math.round(result.interest).toLocaleString()}`;
        months.textContent = result.neverPaysOff ? "—" : String(result.months);
        date.textContent = result.neverPaysOff
            ? "Not reached"
            : result.payoffDate ? 
             result.payoffDate.toLocaleDateString("en-US", {
                  month: "short",
                  year: "numeric",
              }) : "Not reached";
        title.textContent = `${label} plan`;
        first.textContent = result.order[0] || "Credit card";
        explain.textContent = `This example applies $${extra.toLocaleString()}/month above minimum payments using ${label}. ${strategy === "avalanche" ? "The highest-rate balance receives the extra amount first" : "The smallest balance receives the extra amount first"}; when it is paid off, its payment rolls to the next balance.`;
        if (summary)
            summary.textContent = result.neverPaysOff
                ? "This scenario does not pay off within the forecast horizon."
                : `Projected payoff in ${result.months} months, with ${Math.round(result.interest).toLocaleString()} dollars of interest. First payoff target: ${result.order[0]}.`;
    }
    budget.addEventListener("input", update);
    lump.addEventListener("input", update);
    strategyButtons.forEach((b) =>
        b.addEventListener("click", () => {
            strategyButtons.forEach((x) => x.classList.remove("active"));
            b.classList.add("active");
            strategy = b.dataset.strategy as Strategy;
            update();
        }),
    );
    reset.addEventListener("click", () => {
        budget.value = String(200);
        lump.value = String(0);
        strategy = "avalanche";
        strategyButtons.forEach((b) =>
                b.classList.toggle(
                    "active",
                    b.dataset.strategy === "avalanche",
                ),
        );
        update();
    });
    update();
</script>
