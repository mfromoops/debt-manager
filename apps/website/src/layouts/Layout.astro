---
import "../styles/global.css";

const { title = "DebtFold" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width"
    /><meta
      name="description"
      content="See what your debt decisions change before you make them."
    /><title>{title}</title></head
  ><body><slot /></body>
</html>
<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Manrope:wght@400;500;600&display=swap");
  :root {
    --bg: var(--color-canvas);
    --surface: var(--color-surface);
    --ink: var(--color-ink);
    --subtle: var(--color-muted);
    --accent: var(--color-brand);
    --soft: var(--color-soft);
    --border: var(--color-border);
    --hair: var(--color-hairline);
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font:
      16px/1.55 "DM Sans",
      sans-serif;
  }
  
</style>
