---
const { title = 'Debt Manager' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="See what your debt decisions change before you make them."/><title>{title}</title></head><body><slot /></body></html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Manrope:wght@400;500;600&display=swap');
:root{--bg:#fbfcfa;--surface:#fff;--ink:#1d2521;--subtle:#6f7973;--accent:#2d6a4f;--soft:#f3f7f4;--border:#dce8e0;--hair:#e8ece9}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 'DM Sans',sans-serif}a{color:inherit;text-decoration:none}.wrap{max-width:1180px;margin:auto;padding:0 32px}.nav{height:88px;border-bottom:1px solid var(--hair);display:flex;align-items:center;gap:35px}.wordmark{font:600 18px 'Manrope';letter-spacing:-.05em;margin-right:auto}.mark{display:inline-grid;place-items:center;border-radius:50%;background:var(--accent);color:#fff;width:25px;height:25px;margin-right:7px}.nav-links{display:flex;gap:28px;color:var(--subtle);font-size:14px}.button{display:inline-flex;gap:14px;align-items:center;background:var(--accent);color:#fff;border:1px solid var(--accent);border-radius:4px;padding:12px 17px;font-size:14px;font-weight:500}.button:hover{background:#22533d}.small{padding:8px 13px}.text-link{color:var(--accent);font-size:14px;font-weight:500}h1,h2,h3{font-family:'Manrope';font-weight:500;letter-spacing:-.06em;line-height:1.08;margin:0}h1{font-size:clamp(46px,6vw,76px);max-width:720px}h1 em{font-style:normal;color:var(--accent)}h2{font-size:clamp(35px,4.5vw,56px);max-width:760px}.eyebrow{color:var(--accent);font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;margin:0 0 21px}.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:70px;padding-top:110px;padding-bottom:120px;align-items:center}.lede{color:var(--subtle);font-size:19px;max-width:560px;margin:30px 0}.actions{display:flex;gap:28px;align-items:center}.visual{background:#fff;border:1px solid var(--border);border-radius:10px;padding:24px;box-shadow:0 18px 50px #233a2d0b}.visual-label,.legend,.order{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--subtle)}.visual-label{display:flex;justify-content:space-between}.visual-label span{color:#a1aaa4}.visual-top{display:flex;gap:55px;margin:30px 0 13px}.visual-top small{display:block;color:var(--subtle);font-size:12px}.visual-top strong{font:500 28px 'Manrope';letter-spacing:-.05em}.green{color:var(--accent)!important}.chart{width:100%}.grid{fill:none;stroke:var(--hair);stroke-width:1}.line{fill:none;stroke-width:2}.muted{stroke:#bac5be}.accent{stroke:var(--accent)}.legend{display:flex;gap:22px;margin:8px 0 22px}.legend i,.sim-legend i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px}.order{border-top:1px solid var(--hair);padding-top:18px;display:flex;gap:10px}.order span{margin-right:auto}.section{padding:120px 0;border-top:1px solid var(--hair)}.three,.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:50px;margin-top:65px}.three>div,.steps>div{border-top:1px solid var(--ink);padding-top:15px}.three p{font-size:18px;max-width:260px}.num,.steps span{color:var(--accent);font-size:12px}.sim{background:var(--soft);border-color:var(--border)}.intro{margin-bottom:45px}.intro p:last-child{color:var(--subtle);margin-top:20px}.sim-grid{display:grid;grid-template-columns:270px 1fr;gap:18px}.card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:25px}.controls{align-self:start}.control-head{display:flex;justify-content:space-between;align-items:baseline}.control-head .eyebrow{margin:0}.control-head output{color:var(--accent);font-weight:600;white-space:nowrap}input[type=range]{width:100%;accent-color:var(--accent);margin-top:24px}.range{display:flex;justify-content:space-between;color:var(--subtle);font-size:11px}.toggle-label{margin-top:36px}.toggle{display:grid;grid-template-columns:1fr 1fr;padding:3px;background:var(--soft)}.toggle button{border:0;background:transparent;padding:8px;color:var(--subtle);cursor:pointer}.toggle .active{background:#fff;color:var(--ink)}.field{display:block;margin-top:28px;font-size:13px}.input{border:1px solid var(--hair);padding:8px;margin-top:8px;color:var(--subtle)}.input input{border:0;outline:0;width:90%;font:inherit}.reset{border:0;background:none;color:var(--subtle);text-decoration:underline;margin-top:28px;cursor:pointer}.result-head{display:flex;justify-content:space-between}.result-head h3{font-size:23px}.pill{background:var(--soft);color:var(--accent);font-size:10px;padding:5px 8px;height:min-content}.metrics{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid var(--hair);margin:24px 0 12px;padding:16px 0}.metrics small{display:block;color:var(--subtle);font-size:12px}.metrics strong{font:500 24px 'Manrope';letter-spacing:-.05em}.sim-chart{width:100%}.sim-legend{color:var(--subtle);font-size:11px}.payoff{border-top:1px solid var(--hair);margin-top:20px;padding-top:16px;font-size:12px;color:var(--subtle)}.explain{color:var(--subtle);font-size:13px}.disclaimer{font-size:12px;color:var(--subtle)}.steps{grid-template-columns:repeat(4,1fr);margin-bottom:40px}.steps h3{font-size:25px;margin:23px 0 10px}.steps p{color:var(--subtle);font-size:14px;max-width:190px}.institution{background:var(--ink);color:#fff}.institution .eyebrow{color:#91c2a8}.institution-grid,.trust-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px}.institution-grid p:not(.eyebrow),.trust-grid p{color:#b4c0b9;font-size:18px;max-width:500px}.button-light{background:#fff;color:var(--ink);border-color:#fff}.footer{border-top:1px solid var(--hair);padding:38px 0}.footer .wrap{display:flex;gap:25px;align-items:center;flex-wrap:wrap}.footer small{width:100%;color:var(--subtle);font-size:11px}.footer a:not(.wordmark){font-size:13px;color:var(--subtle);margin-left:20px}@media(max-width:800px){.wrap{padding:0 20px}.nav{height:70px}.nav-links{display:none}.hero{display:block;padding-top:70px;padding-bottom:80px}.hero-visual{margin-top:50px}.hero h1{font-size:50px}.three,.steps,.institution-grid,.trust-grid{grid-template-columns:1fr;gap:28px}.section{padding:78px 0}.sim-grid{grid-template-columns:1fr}.controls{order:2}.steps{margin-top:40px}.actions{align-items:flex-start;flex-direction:column;gap:18px}.order{flex-wrap:wrap}.order span{width:100%;margin:0}}
</style>
<style>.simple{padding-top:55px;padding-bottom:120px;max-width:900px}.simple .wordmark{display:block;margin-bottom:120px}.simple h1{margin:10px 0 28px}.simple h2{font-size:32px;margin-top:80px}.simple .lede{max-width:680px;margin:0 0 30px}.back{display:block;color:var(--accent);font-size:14px;margin-top:90px}</style>
