<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_card_green">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THIS PAYMENT CYCLE" android:textColor="#2D6A4F" android:textSize="10sp" android:letterSpacing="0.12" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Plan to pay" android:textColor="#8A8F8A" android:textSize="12sp" />
    <TextView android:id="@+id/primary_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="$0" android:textColor="#111411" android:textSize="30sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
    <TextView android:id="@+id/secondary_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8A8F8A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="11dp" android:layout_marginBottom="9dp" android:background="#DCE8E0" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MINIMUM DUE" android:textColor="#8A8F8A" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/minimum_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#111411" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEXT PAYMENT" android:textColor="#8A8F8A" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/next_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#111411" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/next_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8A8F8A" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
